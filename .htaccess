Options -Indexes
ServerSignature Off
ErrorDocument 400 /greenportal/erro.php?status=400
ErrorDocument 403 /greenportal/erro.php?status=403
ErrorDocument 404 /greenportal/erro.php?status=404
ErrorDocument 500 /greenportal/erro.php?status=500
ErrorDocument 502 /greenportal/erro.php?status=502
ErrorDocument 503 /greenportal/erro.php?status=503

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# Limite de envio de arquivos (ex.: .mdb das unidades na Atualização do Access)
<IfModule php_module>
    php_value upload_max_filesize 100M
    php_value post_max_size 110M
    php_value max_input_time 600
    php_value max_execution_time 600
    # 26/11/2026: sessão do servidor dura 1 h sem uso (o portal encerra por inatividade aos 30 min, Configurações › Main).
    # O padrão do PHP (24 min) derrubava a sessão antes dos 30 min e o usuário voltava para o login.
    php_value session.gc_maxlifetime 3600
</IfModule>
